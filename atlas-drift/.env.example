# Copy to .dev.vars for local development. Never commit real values.
GENAI_API_KEY=
# Use an exact model ID accessible to your Purdue account, from GET /api/models.
GENAI_MODEL=
# Optional: vllm or ollama. Omit to use prompt-only JSON with validation.
GENAI_BACKEND=
# A stable random secret, at least 32 characters. Changing it invalidates saved games.
GAME_SECRET=
